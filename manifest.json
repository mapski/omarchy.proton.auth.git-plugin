{
  "schemaVersion": 1,
  "id": "io.github.mapski.proton-authenticator",
  "name": "Proton Authenticator",
  "version": "1.1.0",
  "author": "MP",
  "license": "MIT",
  "description": "Private-by-default Proton Authenticator codes in the Omarchy bar: fuzzy search, pins, current/next previews and sensitive copying. Local vault access, no native build or runtime network requests.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "Proton Authenticator",
    "description": "Show, search and copy TOTP codes from Proton Authenticator without opening the app window.",
    "category": "Security",
    "aliases": [
      "protonauth",
      "proton-authenticator",
      "authenticator",
      "2fa",
      "totp",
      "otp"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "clipboardClearSec": 20,
      "demoMode": false,
      "closeOnCopy": true,
      "staleHours": 24
    },
    "schema": [
      {
        "key": "clipboardClearSec",
        "type": "integer",
        "label": "Clipboard lifetime (seconds)",
        "min": 5,
        "max": 120,
        "step": 5,
        "defaultValue": 20
      },
      {
        "key": "demoMode",
        "type": "boolean",
        "label": "Demo mode (fake accounts, for screenshots)",
        "defaultValue": false
      },
      {
        "key": "closeOnCopy",
        "type": "boolean",
        "label": "Close after copying",
        "defaultValue": true
      },
      {
        "key": "staleHours",
        "type": "integer",
        "label": "Warn after vault unchanged (hours)",
        "min": 1,
        "max": 168,
        "step": 1,
        "defaultValue": 24
      }
    ]
  }
}
