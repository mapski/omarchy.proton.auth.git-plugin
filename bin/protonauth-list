#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
# Use distro cryptography; prevent Python/user-site and loader environment injection.
exec /usr/bin/env -u PYTHONPATH -u PYTHONHOME -u LD_PRELOAD -u LD_LIBRARY_PATH \
  /usr/bin/python3 -E -s "$HERE/protonauth_list.py" "$@"
